 *
 * Piantor Pro BT — Colemak-DH layout
 *
 * Philosophy:
 *   - Familiar anchor keys: Esc, Tab, Shift, Space, Command, Option stay
 *     roughly where they are on a standard keyboard
 *   - Thumb cluster: Nav(outer-L) | Option(mid-L) | Space/Cmd(inner-L)
 *                    Backspace(inner-R) | Enter(mid-R) | Symbols(outer-R)
 *   - Outer pinky columns: Esc/Tab/Shift on left, '/−/unused on right
 *   - Combined Symbols+Numbers layer optimized for Python/TypeScript
 *   - Nav layer with arrows, page nav, function keys, BT controls
 *
 * Layer map:
 *   0 - COLEMAK  base layer
 *   1 - SYM      symbols + numbers (hold outer-R thumb)
 *   2 - NAV      navigation + F-keys + BT (hold outer-L thumb)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    macros {
        // Python/TS: =>
        arrow_fat: arrow_fat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "ARROW_FAT";
        };

        // Python/TS: ->
        arrow_thin: arrow_thin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW_THIN";
        };

        // TS: ?.
        optional_chain: optional_chain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QMARK &kp DOT>;
            label = "OPTIONAL_CHAIN";
        };

        // Python/TS: ...
        ellipsis: ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT &kp DOT>;
            label = "ELLIPSIS";
        };
    };

    behaviors {
        // Tap: Space | Hold: Command (GUI)
        spc_cmd: spc_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────────────────
        // Layer 0: COLEMAK-DH
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │ ESC  │  Q   │  W   │  F   │  P   │  B   │ │  J   │  L   │  U   │  Y   │  ;   │  '   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │ TAB  │  A   │  R   │  S   │  T   │  G   │ │  M   │  N   │  E   │  I   │  O   │  -   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │ SHFT │  Z   │  X   │  C   │  D   │  V   │ │  K   │  H   │  ,   │  .   │  /   │  \   │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │ NAV  │ OPT  │SPC/CM│ │ BSPC │ ENT  │ SYM  │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
                &kp ESC   &kp Q &kp W &kp F &kp P &kp B    &kp J &kp L &kp U     &kp Y   &kp SEMI &kp SQT
                &kp TAB   &kp A &kp R &kp S &kp T &kp G    &kp M &kp N &kp E     &kp I   &kp O    &kp MINUS
                &kp LSHFT &kp Z &kp X &kp C &kp D &kp V    &kp K &kp H &kp COMMA &kp DOT &kp FSLH &kp BSLH
                          &mo 2  &kp LALT  &spc_cmd LGUI SPACE    &kp BSPC  &kp RET  &mo 1
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 1: SYMBOLS + NUMBERS
        // Activated by: hold outer-R thumb
        //
        // Design goals:
        //   - Numbers on right home row (easy to remember: 1-5 top, 6-0 home)
        //   - High-freq symbols on left home row
        //   - Python/TS macros on left top row
        //   - Brackets paired logically
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │  `   │  =>  │  ->  │  ?.  │  ... │      │ │      │  7   │  8   │  9   │  0   │      │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │  !   │  @   │  #   │  $   │  %   │ │  ^   │  4   │  5   │  6   │  *   │  =   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │  (   │  )   │  [   │  ]   │  {   │ │  }   │  1   │  2   │  3   │  +   │  &   │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │      │  |   │  _   │ │  DEL │      │ [HLD]│
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &arrow_fat    &arrow_thin   &optional_chain &ellipsis &trans       &trans    &kp N7 &kp N8 &kp N9 &kp N0    &trans
                &trans    &kp EXCL      &kp AT        &kp HASH        &kp DLLR  &kp PRCNT    &kp CARET &kp N4 &kp N5 &kp N6 &kp ASTRK &kp EQUAL
                &trans    &kp LPAR      &kp RPAR      &kp LBKT        &kp RBKT  &kp LBRC     &kp RBRC  &kp N1 &kp N2 &kp N3 &kp PLUS  &kp AMPS
                                        &trans        &kp PIPE        &kp UNDER              &kp DEL   &trans &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 2: NAV + FUNCTION + BT
        // Activated by: hold outer-L thumb
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │      │  F1  │  F2  │  F3  │  F4  │  F5  │ │  F6  │  F7  │  F8  │  F9  │ F10  │ F11  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │ BT0  │ BT1  │ BT2  │ BT3  │ BT4  │ │ LEFT │ DOWN │  UP  │ RGHT │ HOME │  END │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │BTCLR │      │      │      │      │ │ PGDN │ PGUP │      │      │      │ F12  │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │ [HLD]│      │      │ │      │      │      │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        nav_layer {
            display-name = "NAV";
            bindings = <
                &trans &kp F1       &kp F2 &kp F3 &kp F4 &kp F5    &kp F6   &kp F7   &kp F8 &kp F9    &kp F10  &kp F11
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp HOME &kp END
                &trans &bt BT_CLR   &trans &trans &trans &trans    &kp PG_DN &kp PG_UP &trans &trans    &trans   &kp F12
                       &trans       &trans &trans                  &trans    &trans    &trans
            >;
        };
    };
};
