 *
 * Piantor Pro BT — Colemak-DH layout v9
 *
 * Thumb cluster:
 *   Left:  [SHIFT] [OPTION] [SPACE/CMD]
 *   Right: [BSPC]  [ENT/NAV] [SYM]
 *
 * Home row mods:
 *   Hold A = Ctrl (left), Hold O = Ctrl (right)
 *
 * Outer left pinky column:
 *   ESC / TAB / !?
 *
 * Right pinky column (standard Colemak-DH positions):
 *   :;  (colon primary — frequency swap via mod-morph)
 *   O
 *   /~  (tilde shifted — path-friendly pair via mod-morph)
 *
 * Right outer pinky column:
 *   \|  (standard shifted pair)
 *   '"  (standard shifted pair)
 *   -_  (standard shifted pair)
 *
 * Mod-morphs:
 *   colon_semi : unshifted, ; shifted
 *   slash_tilde / unshifted, ~ shifted
 *   excl_ques  ! unshifted, ? shifted
 *
 * Layers:
 *   0 - COLEMAK   base
 *   1 - SYM       left=symbols, right=numpad  (hold right outer thumb)
 *   2 - NAV       navigation + FN + BT        (hold right mid thumb)
 *
 * Caps Word: combo Shift + Space
 *
 * SYM layer:
 *   Left hand — symbols:
 *     top:      `  !  @  #  ^  &
 *     home: "   |  (  [  {  =
 *     bot:  :   ~  )  ]  }  +
 *
 *   Right hand — numpad:
 *     top:  *  7  8  9  0  $
 *     home: /  4  5  6     _
 *     bot:  \  1  2  3     %
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        // Tap: Space | Hold: Command
        spc_cmd: spc_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Tap: Enter | Hold: NAV layer
        ent_nav: ent_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "ENT_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // Hold A = Ctrl — only triggers on right-hand keys
        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_A";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Hold O = Ctrl — only triggers on left-hand keys
        ctrl_o: ctrl_o {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_O";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // : unshifted, ; shifted
        colon_semi: colon_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // / unshifted, ~ shifted
        slash_tilde: slash_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_TILDE";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ! unshifted, ? shifted
        excl_ques: excl_ques {
            compatible = "zmk,behavior-mod-morph";
            label = "EXCL_QUES";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Caps Word: Shift + Space
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 38>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────────────────
        // Layer 0: COLEMAK-DH
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │ ESC  │  Q   │  W   │  F   │  P   │  B   │ │  J   │  L   │  U   │  Y   │  :;  │  \|  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │ TAB  │ A/CT │  R   │  S   │  T   │  G   │ │  M   │  N   │  E   │  I   │O/CTL │  '"  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  !?  │  Z   │  X   │  C   │  D   │  V   │ │  K   │  H   │  ,   │  .   │  /~  │  -_  │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │ SHFT │ OPT  │SPC/CM│ │ BSPC │ENT/NV│ SYM  │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
                &kp ESC        &kp Q           &kp W &kp F &kp P &kp B    &kp J &kp L &kp U     &kp Y   &colon_semi      &kp BSLH
                &kp TAB        &ctrl_a LCTRL A &kp R &kp S &kp T &kp G    &kp M &kp N &kp E     &kp I   &ctrl_o LCTRL O  &kp SQT
                &excl_ques     &kp Z           &kp X &kp C &kp D &kp V    &kp K &kp H &kp COMMA &kp DOT &slash_tilde      &kp MINUS
                               &kp LSHFT  &kp LALT  &spc_cmd LGUI SPACE   &kp BSPC  &ent_nav 2 RET  &mo 1
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 1: SYM — left=symbols, right=numpad
        // Hold right outer thumb
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │      │  `   │  !   │  @   │  #   │  ^   │ │  &   │  *   │  7   │  8   │  9   │  0   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  "   │  |   │  (   │  [   │  {   │  =   │ │  _   │  /   │  4   │  5   │  6   │  $   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  :   │  ~   │  )   │  ]   │  }   │  +   │ │  -   │  \   │  1   │  2   │  3   │  %   │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │      │      │      │ │ DEL  │      │[HLD] │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        sym_layer {
            display-name = "SYM";
            bindings = <
                &trans    &kp GRAVE &kp EXCL &kp AT   &kp HASH &kp CARET    &kp AMPS  &kp ASTRK &kp N7 &kp N8 &kp N9  &kp N0
                &kp DQT   &kp PIPE  &kp LPAR &kp LBKT &kp LBRC &kp EQUAL    &kp UNDER &kp FSLH  &kp N4 &kp N5 &kp N6  &kp DLLR
                &kp COLON &kp TILDE &kp RPAR &kp RBKT &kp RBRC &kp PLUS     &kp MINUS &kp BSLH  &kp N1 &kp N2 &kp N3  &kp PRCNT
                                    &trans   &trans   &trans                 &kp DEL   &trans    &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 2: NAV + FUNCTION + BT
        // Tap Enter / Hold to activate (right mid thumb)
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │      │  F1  │  F2  │  F3  │  F4  │  F5  │ │  F6  │  F7  │  F8  │  F9  │ F10  │ F11  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │ BT0  │ BT1  │ BT2  │ BT3  │ BT4  │ │ LEFT │ DOWN │  UP  │ RGHT │ HOME │  END │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │BTCLR │      │      │ RST  │ BOOT │ │ PGDN │ PGUP │      │      │      │ F12  │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │      │      │      │ │      │[HLD] │      │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        nav_layer {
            display-name = "NAV";
            bindings = <
                &trans &kp F1       &kp F2       &kp F3       &kp F4     &kp F5          &kp F6    &kp F7    &kp F8 &kp F9    &kp F10  &kp F11
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP &kp RIGHT &kp HOME &kp END
                &trans &bt BT_CLR   &trans       &trans       &sys_reset &bootloader     &kp PG_DN &kp PG_UP &trans &trans    &trans   &kp F12
                       &trans       &trans       &trans                                  &trans    &trans    &trans
            >;
        };
    };
};
