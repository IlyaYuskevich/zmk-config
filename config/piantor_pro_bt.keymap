 *
 * Piantor Pro BT — Colemak-DH layout v11
 *
 * Changes from v10:
 *   SYM layer rework — clean dupes, add ligature macros and prose marks:
 *
 *     Left hand:
 *       col 0 (outer): —  =>  …      (em-dash / fat-arrow / ellipsis)
 *       col 1:         |  <  >       (| top, < and > paired below)
 *       col 2:         `  (  )       (grave moved here from col 1 top)
 *       col 3-5:       @ [ ] / # { } / ^ = +   (unchanged)
 *
 *     Right hand (numpad columns 8-10 preserved):
 *       col 6:  &  ==  !=     (equality column)
 *       col 7:  *  $   %      (currency column)
 *       col 8-10: 7 8 9 / 4 5 6 / 1 2 3  (numpad)
 *       col 11: 0  <=  >=     (comparison on outer pinky)
 *
 *   Em-dash and ellipsis assume Mac keyboard (Opt+Shift+-, Opt+;).
 *
 * Thumb cluster:
 *   Left:  ESC|SHIFT  ·  BSPC|OPT  ·  SPC|CMD
 *   Right: ENT        ·  TAB|NAV   ·  SYM
 *
 * Home row mods:
 *   Hold A = Ctrl (left), Hold O = Ctrl (right)
 *
 * Base layer pinky columns:
 *   Left outer:  '"  / ?  / !
 *   Right inner: :;  / O  / /~    (colon_semi and slash_tilde mod-morphs)
 *   Right outer: \|  / -  / _
 *
 * Layers:
 *   0 - COLEMAK   base
 *   1 - SYM       left=symbols+prose, right=numpad+ligatures (hold right outer)
 *   2 - NAV       navigation + FN + BT                       (hold right mid)
 *
 * Caps Word: combo left-outer-thumb (ESC tap) + left-inner-thumb (SPACE tap)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    macros {
        // =>  JS/TS arrow, Rust match arm
        m_fatarrow: m_fatarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp EQUAL &kp GT>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // ==  equality
        m_eq: m_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp EQUAL &kp EQUAL>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // !=  inequality
        m_neq: m_neq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp EXCL &kp EQUAL>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // <=  less-or-equal
        m_lte: m_lte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LT &kp EQUAL>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // >=  greater-or-equal
        m_gte: m_gte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp GT &kp EQUAL>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // —  em-dash (Mac: Opt+Shift+-)
        m_emdash: m_emdash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_press &kp LSHFT>,
                       <&macro_tap &kp MINUS>,
                       <&macro_release &kp LSHFT>,
                       <&macro_release &kp LALT>;
            wait-ms = <30>;
            tap-ms = <30>;
        };

        // …  ellipsis (Mac: Opt+;)
        m_ellipsis: m_ellipsis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp SEMI>,
                       <&macro_release &kp LALT>;
            wait-ms = <30>;
            tap-ms = <30>;
        };
    };

    behaviors {
        // Tap: Space | Hold: Command
        spc_cmd: spc_cmd {
            compatible = "zmk,behavior-hold-tap";
            label = "SPC_CMD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Tap: Escape | Hold: Shift
        esc_shft: esc_shft {
            compatible = "zmk,behavior-hold-tap";
            label = "ESC_SHFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Tap: Backspace | Hold: Option/Alt
        bspc_opt: bspc_opt {
            compatible = "zmk,behavior-hold-tap";
            label = "BSPC_OPT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Tap: Tab | Hold: NAV layer
        tab_nav: tab_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_NAV";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // Hold A = Ctrl — only triggers on right-hand keys
        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_A";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Hold O = Ctrl — only triggers on left-hand keys
        ctrl_o: ctrl_o {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_O";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // : unshifted, ; shifted
        colon_semi: colon_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMI";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // / unshifted, ~ shifted
        slash_tilde: slash_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_TILDE";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Caps Word: left-outer-thumb (esc_shft) + left-inner-thumb (spc_cmd)
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <36 38>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────────────────
        // Layer 0: COLEMAK-DH
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │  '"  │  Q   │  W   │  F   │  P   │  B   │ │  J   │  L   │  U   │  Y   │  :;  │  \|  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  ?   │ A/CT │  R   │  S   │  T   │  G   │ │  M   │  N   │  E   │  I   │O/CTL │  -   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  !   │  Z   │  X   │  C   │  D   │  V   │ │  K   │  H   │  ,   │  .   │  /~  │  _   │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │ESC/SH│BSPC/O│SPC/CM│ │ ENT  │TAB/NV│ SYM  │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
                &kp SQT        &kp Q           &kp W &kp F &kp P &kp B    &kp J &kp L &kp U     &kp Y   &colon_semi      &kp BSLH
                &kp QMARK      &ctrl_a LCTRL A &kp R &kp S &kp T &kp G    &kp M &kp N &kp E     &kp I   &ctrl_o LCTRL O  &kp MINUS
                &kp EXCL       &kp Z           &kp X &kp C &kp D &kp V    &kp K &kp H &kp COMMA &kp DOT &slash_tilde     &kp UNDER
                     &esc_shft LSHFT ESC   &bspc_opt LALT BSPC   &spc_cmd LGUI SPACE      &kp RET   &tab_nav 2 TAB   &mo 1
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 1: SYM — left=symbols+prose, right=numpad+ligatures
        // Hold right outer thumb (SYM key)
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │  —   │  |   │  `   │  @   │  #   │  ^   │ │  &   │  *   │  7   │  8   │  9   │  0   │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  =>  │  <   │  (   │  [   │  {   │  =   │ │  ==  │  $   │  4   │  5   │  6   │  <=  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │  …   │  >   │  )   │  ]   │  }   │  +   │ │  !=  │  %   │  1   │  2   │  3   │  >=  │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │      │ DEL  │      │ │      │      │[HLD] │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        sym_layer {
            display-name = "SYM";
            bindings = <
                &m_emdash    &kp PIPE  &kp GRAVE &kp AT   &kp HASH &kp CARET    &kp AMPS    &kp ASTRK &kp N7 &kp N8 &kp N9 &kp N0
                &m_fatarrow  &kp LT    &kp LPAR  &kp LBKT &kp LBRC &kp EQUAL    &m_eq       &kp DLLR  &kp N4 &kp N5 &kp N6 &m_lte
                &m_ellipsis  &kp GT    &kp RPAR  &kp RBKT &kp RBRC &kp PLUS     &m_neq      &kp PRCNT &kp N1 &kp N2 &kp N3 &m_gte
                                       &trans    &kp DEL  &trans                 &trans      &trans    &trans
            >;
        };

        // ─────────────────────────────────────────────────────────────────
        // Layer 2: NAV + FUNCTION + BT
        // Hold right mid thumb (TAB|NAV)
        //
        // ┌──────┬──────┬──────┬──────┬──────┬──────┐ ┌──────┬──────┬──────┬──────┬──────┬──────┐
        // │      │  F1  │  F2  │  F3  │  F4  │  F5  │ │  F6  │  F7  │  F8  │  F9  │ F10  │ F11  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │ BT0  │ BT1  │ BT2  │ BT3  │ BT4  │ │ LEFT │ DOWN │  UP  │ RGHT │ HOME │ END  │
        // ├──────┼──────┼──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┼──────┼──────┤
        // │      │BTCLR │      │      │ RST  │ BOOT │ │ PGDN │ PGUP │      │      │      │ F12  │
        // └──────┴──────┴──────┼──────┼──────┼──────┤ ├──────┼──────┼──────┼──────┴──────┴──────┘
        //                      │      │      │      │ │      │      │[HLD] │
        //                      └──────┴──────┴──────┘ └──────┴──────┴──────┘
        // ─────────────────────────────────────────────────────────────────
        nav_layer {
            display-name = "NAV";
            bindings = <
                &trans &kp F1       &kp F2       &kp F3       &kp F4       &kp F5          &kp F6    &kp F7    &kp F8 &kp F9    &kp F10  &kp F11
                &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP &kp RIGHT &kp HOME &kp END
                &trans &bt BT_CLR   &trans       &trans       &sys_reset   &bootloader     &kp PG_DN &kp PG_UP &trans &trans    &trans   &kp F12
                                    &trans       &trans       &trans                       &trans    &trans    &trans
            >;
        };
    };
};
